{
  "name": "ye-e2e",
  "version": "0.1.0",
  "description": "Selenium + Mocha e2e tests for the extension",
  "type": "module",
  "main": "index.js",
  "config": {
    "hooks": "./utils/hooks.mjs",
    "extAll": "./test/extension/**/*.test.js",
    "extCashback": "./test/extension/cashback/*.test.js",
    "extGeneral": "./test/extension/general/*.test.js",
    "extGovernance": "./test/extension/governance/*.test.js",
    "extNFT": "./test/extension/nfts/*.test.js",
    "extPortfolio": "./test/extension/portfolio/*.test.js",
    "extReceive": "./test/extension/receive/*.test.js",
    "extSend": "./test/extension/send/*.test.js",
    "extSettings": "./test/extension/settings/*.test.js",
    "extTransactions": "./test/extension/transactions/*.test.js",
    "ledger": "./test/ledger/*.test.js",
    "trezor": "./test/trezor/*.test.js",
    "dApp": "./test/dapp/*.test.js"
  },
  "scripts": {
    "test:clean:logs": "find . -type d -name \"testRunsData\" -exec rm -r {} +",
    "test:ext:base": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_extAll --reporter mochawesome",
    "test:ext:cashback:base": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_extCashback --reporter mochawesome",
    "test:ext:general:base": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_extGeneral --reporter mochawesome",
    "test:ext:governance:base": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_extGovernance --reporter mochawesome",
    "test:ext:nft:base": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_extNFT --reporter mochawesome",
    "test:ext:portfolio:base": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_extPortfolio --reporter mochawesome",
    "test:ext:receive:base": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_extReceive --reporter mochawesome",
    "test:ext:send:base": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_extSend --reporter mochawesome",
    "test:ext:settings:base": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_extSettings --reporter mochawesome",
    "test:ext:transactions:base": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_extTransactions --reporter mochawesome",
    "test:ext:base:tag": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_extAll --reporter mochawesome -g",
    "test:ledger:base:sequintel": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_ledger --reporter mochawesome",
    "test:trezor:base:sequintel": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_trezor --reporter mochawesome",
    "test:dapp:base:sequintel": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_dApp --reporter mochawesome",
    "test:base:one": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_extAll -g",
    "test:ledger:base:one": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_ledger -g",
    "test:trezor:base:one": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_trezor -g",
    "test:dapp:base:one": "npm run test:clean:logs && mocha --require $npm_package_config_hooks $npm_package_config_dApp -g",
    "test:ext:all": "env HEADLESS=true npm run test:ext:base",
    "test:ext:cashback": "env HEADLESS=true npm run test:ext:cashback:base",
    "test:ext:general": "env HEADLESS=true npm run test:ext:general:base",
    "test:ext:governance": "env HEADLESS=true npm run test:ext:governance:base",
    "test:ext:nft": "env HEADLESS=true npm run test:ext:nft:base",
    "test:ext:portfolio": "env HEADLESS=true npm run test:ext:portfolio:base",
    "test:ext:receive": "env HEADLESS=true npm run test:ext:receive:base",
    "test:ext:send": "env HEADLESS=true npm run test:ext:send:base",
    "test:ext:settings": "env HEADLESS=true npm run test:ext:settings:base",
    "test:ext:transactions": "env HEADLESS=true npm run test:ext:transactions:base",
    "test:ext:one": "npm run test:base:one",
    "test:ext:smoke": "env HEADLESS=true npm run test:ext:base:tag \"_smoke_\"",
    "test:dapp": "env ISDAPP=true npm run test:dapp:base:sequintel",
    "test:dapp:one": "npm run test:dapp:base:one",
    "test:ledger": "npm run test:ledger:base:sequintel",
    "test:ledger:one": "npm run test:ledger:base:one",
    "test:trezor": "env IS_TREZOR=true npm run test:trezor:base:sequintel",
    "test:trezor:one": "env IS_TREZOR=true npm run test:trezor:base:one"
  },
  "author": "Denis Nebytov (denis@emurgo.io)",
  "license": "ISC",
  "devDependencies": {
    "@emurgo/cardano-serialization-lib-nodejs": "13.2.1",
    "bignumber.js": "^9.1.2",
    "chai": "^4.3.10",
    "chromedriver": "145.0.1",
    "cross-env": "^7.0.3",
    "dockerode": "^4.0.5",
    "json-server": "^0.17.4",
    "mocha": "^10.2.0",
    "mochawesome": "^7.1.3",
    "selenium-webdriver": "^4.19.0",
    "simple-node-logger": "^21.8.12"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "balanced-match": "^1.0.2",
    "brace-expansion": "^1.1.11",
    "concat-map": "^0.0.1",
    "core-util-is": "^1.0.3",
    "fs.realpath": "^1.0.0",
    "glob": "^7.2.3",
    "immediate": "^3.0.6",
    "inflight": "^1.0.6",
    "inherits": "^2.0.4",
    "isarray": "^1.0.0",
    "jszip": "^3.10.1",
    "lie": "^3.3.0",
    "minimatch": "^3.1.2",
    "once": "^1.4.0",
    "pako": "^1.0.11",
    "path-is-absolute": "^1.0.1",
    "process-nextick-args": "^2.0.1",
    "readable-stream": "^2.3.8",
    "rimraf": "^3.0.2",
    "safe-buffer": "^5.1.2",
    "setimmediate": "^1.0.5",
    "string_decoder": "^1.1.1",
    "tmp": "^0.2.1",
    "util-deprecate": "^1.0.2",
    "wrappy": "^1.0.2",
    "ws": "^8.14.2"
  },
  "keywords": []
}
